# ============================================================
# 环境变量示例文件 —— 部署时复制为 .env 并填入真实值
# .env 文件已被 .gitignore 忽略,绝不提交到版本库
# ============================================================

# Django 核心配置
# 生产环境务必使用 `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` 生成新密钥
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置(MySQL)
DATABASE_URL=mysql://username:password@localhost:3306/mydb1

# Redis(缓存与 Session;P2 起启用)
# REDIS_URL=redis://127.0.0.1:6379/0

# ===== 安全相关(生产环境建议全部开启) =====
# 是否强制 HTTPS 跳转
SECURE_SSL_REDIRECT=False
# Cookie 是否仅通过 HTTPS 传输(生产环境设 True)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# HSTS(仅在确认长期 HTTPS 后开启)
HSTS_SECONDS=0

# ===== 验证码(可选,P0 阶段使用默认) =====
# CAPTCHA_LENGTH=5

# ===== 消息通知(P3 启用,留位) =====
# 阿里云短信
# ALIYUN_SMS_ACCESS_KEY=
# ALIYUN_SMS_ACCESS_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# 邮件(SMTP)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=465
# DEFAULT_FROM_EMAIL=
